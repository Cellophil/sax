# /etc/systemd/system/sax.service
[Unit]
Description=SAX Battery Control Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust ExecStart path to your Python and repository path on the target host
# Example uses a venv in /home/<user>/sax/.venv
EnvironmentFile=-/etc/sax/sax.env
Environment=SAX_LOG_LEVEL=INFO
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/andreas
Environment=HOME=/home/andreas
User=andreas
WorkingDirectory=/home/andreas
ExecStart=/bin/bash /home/andreas/sax/run_sax.sh
Restart=always
RestartSec=10
# Optional: Limit resources, add nice/IOSchedulingPriority if desired

# Log to journald; steuerung.py also writes its own rotating file
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
